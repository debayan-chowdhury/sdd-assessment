PORT=4000
MONGO_URI=mongodb://localhost:27018/sdd_assessment

# Static admin login (BRD-005) — defaults to admin/admin if unset
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=0000000000
ADMIN_JWT_SECRET=change-me-in-every-environment

# Employee portal login (BRD_Employee_Transfer.md#BRD-001) — separate secret from ADMIN_JWT_SECRET
EMPLOYEE_JWT_SECRET=change-me-in-every-environment-too
